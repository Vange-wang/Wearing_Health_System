+    content = re.sub(line_start + r">[ \t]?", "", content, flags=re.MULTILINE)
+    content = re.sub(line_start + r"[-*+][ \t]+", "", content, flags=re.MULTILINE)
+    content = _MD_ASTERISK_LEFT.sub("", content)
+    return text[:left] + content + text[right:]
