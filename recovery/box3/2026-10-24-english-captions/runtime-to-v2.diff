+    content = _MD_INLINE_CODE.sub(r"\1", content)
+    # Horizontal whitespace only: \s* here would swallow blank paragraphs.
+    content = re.sub(line_start + r"#{1,6}[ \t]*", "", content, flags=re.MULTILINE)
